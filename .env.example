# Database Configuration (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# The Prisma provider and runtime driver adapter are inferred from the
# DATABASE_URL scheme (postgresql:// -> postgres, otherwise sqlite), so no
# provider switch is needed for normal use. Override only if required:
# DATABASE_PROVIDER="sqlite"  # or "postgresql"
# On Vercel, set DATABASE_PROVIDER=postgresql so `prisma generate` at build
# time picks the correct schema even if DATABASE_URL isn't available during build.

# For production, use PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/lostfound"

# JWT Secret (minimum 16 characters, use a secure random string)
# Generate with: openssl rand -hex 32
# REQUIRED in production. Never use the placeholder value in production.
JWT_SECRET="your-secure-jwt-secret-at-least-16-chars"

# Bootstrap credentials used by `pnpm db:seed` to create the initial users.
# In production these are REQUIRED: seeding hard-fails without them so insecure
# local-dev defaults can never be written to a real deployment. Local dev falls
# back to fixed dev-only defaults when these empty (see prisma/seed.ts).
# Generate each with: openssl rand -hex 24
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_VOLUNTEER_PASSWORD=""
BOOTSTRAP_USER_PASSWORD=""

# Vercel Blob Storage (REQUIRED in production for item + claim-proof uploads)
# Create a Blob store at https://vercel.com/dashboard/stores → Blob
BLOB_READ_WRITE_TOKEN=""

# Public site URL (REQUIRED in production for CSRF, sitemap, robots, metadata)
# Used by assertSameOrigin for CSRF checks and by sitemap.ts / robots.ts / layout.tsx
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Environment
NODE_ENV="development"
